# ═══════════ Railway → tu servicio → Variables ═══════════
# Solo estas dos son obligatorias:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── General ──
# 1m 3m 5m 15m 30m 1h (el Pine estaba en 15m)
TIMEFRAME=15m
# BOTH | EP | PS
SETUPS=BOTH
# USDT de referencia para el tamaño sugerido (no opera)
ACCOUNT_EQUITY=1000
# liquidez mínima 24h en USDT (0 = analizar absolutamente todo)
MIN_QUOTE_VOL_24H=100000
# lista separada por comas, ej: DOGE-USDT,PEPE
EXCLUDE_SYMBOLS=

# ── Sesión (igual que el Pine) ──
# 0 = día UTC (cripto). Apertura US = 810
SESS_OFFSET_MIN=0
OR_MINUTES=15
SKIP_FIRST_MIN=5
WINDOW_MIN=1080
DAY_LEN_MIN=1440
MAX_TRADES_DAY=2

# ── Riesgo ──
RISK_PCT_EP=0.35
RISK_PCT_SHORT=0.25
MAX_POS_PCT=22
MAX_ADR_MULT=1.3
# DAY | OR | ATR
STOP_MODE=DAY
SL_BUF=0.1

# ── EP Long ──
EP_MIN_CHANGE=7
EP_MIN_ADR=3.5
EP_MIN_RVOL=1.5
# ORH | HH | VWAP_EMA
EP_TRIGGER=ORH

# ── Parabolic Short ──
PS_MIN_GAIN=50
PS_LOOKBACK=15
PS_MIN_GREEN=3
PS_MIN_EXT=25
# ORL | FIRST_RED | VWAP_FAIL
PS_TRIGGER=ORL

# ── Gestión ──
PARTIAL_R=1.8
PARTIAL_PCT=50
USE_TRAIL_EMA=true
# 10 | 20
TRAIL_EMA_LEN=10
# 0 = desactivado
MAX_HOLD_BARS=0

# ── Avisos ──
# candidatas armadas (EP) / contexto activo (PS)
SEND_RADAR=true
RADAR_MAX=15
SEND_DAILY_SUMMARY=true
SEND_STARTUP=true

# ── Técnicas ──
# peticiones/segundo a BingX
API_RPS=8
CONCURRENCY=8
# espera tras el cierre de vela
CANDLE_DELAY_SEC=8
MAX_SIGNAL_AGE_BARS=1
LOG_LEVEL=INFO
# STATE_DIR=/data             # opcional; Railway lo detecta solo si montas un Volume
