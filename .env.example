# ── Obligatorias ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-tu-token
TELEGRAM_CHAT_ID=123456789
# TELEGRAM_THREAD_ID=            # opcional: id del tema si usas un grupo con temas

# ── General ───────────────────────────────────────────────
ACTIVE_SETUP=BOTH                # BOTH | EP | PS
TIMEFRAME=5m                     # 1m 3m 5m 15m 30m 1h
MIN_QUOTE_VOLUME=100000          # volumen 24h mínimo en USDT (0 = analizar TODO sin filtro)
# SYMBOL_WHITELIST=BTC,ETH       # opcional: solo estos
# SYMBOL_BLACKLIST=              # opcional: excluir estos
ACCOUNT_EQUITY=10000             # solo para calcular el tamaño sugerido en los mensajes
REPLAY_DAYS=3                    # días re-simulados (seguimiento de posiciones virtuales)
MAX_EVENT_AGE_BARS=3             # no enviar eventos con más de N velas de antigüedad
HEARTBEAT_HOURS=6                # mensaje de estado cada N horas (0 = desactivado)
SEND_EXIT_UPDATES=true           # avisos de TP1 / stop / trail / tiempo

# ── Sesión (cripto 24/7 en UTC) ───────────────────────────
SESS_OFFSET_MIN=0
OR_MINUTES=15
SKIP_FIRST_MIN=5
WINDOW_MIN=1080
DAY_LEN_MIN=1440
MAX_TRADES_DAY=2

# ── Riesgo ────────────────────────────────────────────────
RISK_PCT_EP=0.35
RISK_PCT_SHORT=0.25
MAX_POS_PCT=22
MAX_ADR_MULT=1.3
STOP_MODE=DAY                    # DAY | OR | ATR
SL_BUF_ATR=0.1

# ── EP Long ───────────────────────────────────────────────
EP_MIN_CHANGE=7
EP_MIN_ADR=3.5
EP_MIN_RVOL=1.5
EP_TRIGGER=ORH                   # ORH | VWAP_EMA | HH

# ── Parabolic Short ───────────────────────────────────────
PS_MIN_GAIN=50
PS_LOOKBACK=15
PS_MIN_GREEN=3
PS_MIN_EXT=25
PS_TRIGGER=ORL                   # ORL | FIRST_RED | VWAP_FAIL

# ── Gestión ───────────────────────────────────────────────
PARTIAL_R=1.8
PARTIAL_PCT=50
USE_TRAIL_EMA=true
TRAIL_EMA_LEN=10                 # 10 o 20
MAX_HOLD_BARS=0                  # 0 = desactivado

# ── Extras ────────────────────────────────────────────────
SEND_CHARTS=true                 # gráfico PNG con cada entrada
CHART_BARS=120                   # velas visibles en el gráfico
LIVE_POLL_SEC=20                 # vigila stop/TP1 con precio en vivo cada N s (0 = solo al cierre de vela)
COMMANDS_ENABLED=true            # /status /posiciones /watchlist /analiza /config /pausa /reanudar

# ── Técnicas ──────────────────────────────────────────────
# STATE_PATH=/data/state.json    # solo si montas un Volume en Railway
# CONCURRENCY=6
# RATE_LIMIT_MS=120
# BAR_CLOSE_DELAY_SEC=8
# LOG_LEVEL=INFO
